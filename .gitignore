# extracted stock script sources are for local reference only (Epic code)
reference/
*.log
tools/*.bak

# binary packages built straight into the game copy
*.u
*.ucl

# ...except the tracked release binary that tools/build.sh refreshes. GitHub
# Actions packages this because it cannot run the UT2004 compiler.
!prebuilt/System/*.u
!prebuilt/System/*.ucl

# locally generated release zips
/dist/

# built/install output lives in $UT2004_DIR/System, not here
